pipeline {
    agent any 
    tools {
        jdk 'jdk'          // Ensure this label is correct in Global Tool Configuration
        nodejs 'nodejs'    // Ensure this label is correct in Global Tool Configuration
    }

    environment  {
        SCANNER_HOME = "${tool 'sonar-scanner'}"
        AWS_ACCOUNT_ID = credentials('ACCOUNT_ID')
        AWS_ECR_REPO_NAME = credentials('ECR_REPO2')
        AWS_DEFAULT_REGION = 'us-east-1'
        REPOSITORY_URI = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_DEFAULT_REGION}.amazonaws.com/"
    }

    stages {
        stage('Cleaning Workspace') {
            steps { cleanWs() }
        }

        stage('Checkout from Git') {
            steps {
                git branch: 'e2e-3-tier-DevSecOps', credentialsId: 'github-token', url: 'https://github.com/asare905/DevOps.git'
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('Application-Code/backend') {
                    withSonarQubeEnv('sonar-server') {
                        withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN')]) {
                            sh """
                                ${SCANNER_HOME}/bin/sonar-scanner \
                                -Dsonar.projectKey=backend \
                                -Dsonar.projectName=backend \
                                -Dsonar.sources=. \
                                -Dsonar.login=${SONAR_TOKEN} \
                                -Dsonar.qualitygate.wait=true
                            """
                        }
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                script {
                    waitForQualityGate abortPipeline: false, credentialsId: 'sonar'
                }
            }
        }

        stage('Install Node Modules') {
            steps {
                dir('Application-Code/backend') {
                    sh 'npm install'
                }
            }
        }

        stage('OWASP Dependency-Check Scan') {
            steps {
                dir('Application-Code/backend') {
                    withCredentials([string(credentialsId: 'nvd-api-key', variable: 'NVD_API_KEY')]) {
                        dependencyCheck(
                            odcInstallation: 'DP-Check',
                            scanPath: '.',
                            format: 'HTML',
                            disableNodeAudit: true,
                            disableYarnAudit: true,
                            nvdApiKey: env.NVD_API_KEY,
                            failBuildOnCVSS: 10.0,
                            skipOnError: true // <--- ensures pipeline doesn't fail
                        )
                    }
                    dependencyCheckPublisher pattern: '**/dependency-check-report.html'
                }
            }
        }

        stage('Trivy File Scan') {
            steps {
                dir('Application-Code/backend') {
                    sh 'trivy fs . > trivyfs.txt'
                }
            }
        }

        stage('NVD Vulnerability Check') {
            steps {
                withCredentials([string(credentialsId: 'nvd-api-key', variable: 'NVD_API_KEY')]) {
                    sh '''
                      curl -s -H "apiKey: $NVD_API_KEY" \
                        "https://services.nvd.nist.gov/rest/json/cves/2.0?keywordSearch=nodejs&resultsPerPage=10" \
                        -o nvd_vulns.json
                      echo "NVD vulnerabilities saved to nvd_vulns.json"
                    '''
                }
            }
        }

        stage("Docker Image Build") {
            steps {
                dir('Application-Code/backend') {
                    sh 'docker system prune -f'
                    sh 'docker container prune -f'
                    sh 'docker build -t ${AWS_ECR_REPO_NAME} .'
                }
            }
        }

        stage("ECR Image Pushing") {
            steps {
                script {
                    sh 'aws ecr get-login-password --region ${AWS_DEFAULT_REGION} | docker login --username AWS --password-stdin ${REPOSITORY_URI}'
                    sh 'docker tag ${AWS_ECR_REPO_NAME} ${REPOSITORY_URI}${AWS_ECR_REPO_NAME}:${BUILD_NUMBER}'
                    sh 'docker push ${REPOSITORY_URI}${AWS_ECR_REPO_NAME}:${BUILD_NUMBER}'
                }
            }
        }

        stage("Trivy Image Scan") {
            steps {
                sh 'trivy image ${REPOSITORY_URI}${AWS_ECR_REPO_NAME}:${BUILD_NUMBER} > trivyimage.txt'
            }
        }

        stage('Checkout Code (again)') {
            steps {
                git branch: 'e2e-3-tier-DevSecOps', credentialsId: 'github-token', url: 'https://github.com/asare905/DevOps.git'
            }
        }

        stage('Update Kubernetes Deployment') {
            environment {
                GIT_REPO_NAME = "DevOps"
                GIT_USER_NAME = "asare905"
            }
            steps {
                dir('Kubernetes-Manifests-file/Backend') {
                    withCredentials([string(credentialsId: 'github-token', variable: 'GITHUB_TOKEN')]) {
                        sh '''
                            git config user.email "asare905@gmail.com"
                            git config user.name "asare905"
                            BUILD_NUMBER=${BUILD_NUMBER}
                            imageTag=$(grep -oP '(?<=backend:)[^ ]+' deployment.yaml)
                            sed -i "s/${AWS_ECR_REPO_NAME}:${imageTag}/${AWS_ECR_REPO_NAME}:${BUILD_NUMBER}/" deployment.yaml
                            git add deployment.yaml
                            git commit -m "Update deployment Image to version ${BUILD_NUMBER}"
                            git push https://${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME} HEAD:e2e-3-tier-DevSecOps
                        '''
                    }
                }
            }
        }
    }

    post {
        always { cleanWs() }
    }
}
